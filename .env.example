# Copy this file to .env.local and fill in the values.
# On Vercel: Project -> Settings -> Environment Variables.

# MongoDB connection string (MongoDB Atlas free tier works).
# Leave empty to run the site on built-in sample data (demo mode).
MONGODB_URI=
MONGODB_DB=btebresult

# Public site URL, used for SEO tags and the sitemap.
NEXT_PUBLIC_SITE_URL=https://btebresulthub.com

# Optional contact links shown on the Contact page.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_TELEGRAM_URL=
